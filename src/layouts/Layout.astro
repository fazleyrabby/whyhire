---
import '../styles/global.css';
import AISummarizer from '../components/AISummarizer';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Md. Fazley Rabbi - PHP/Laravel Engineer. I build systems that survive production." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://whyhire.fazleyrabbi.xyz" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO / OpenGraph -->
    <title>{title}</title>
    <meta name="description" content="Md. Fazley Rabbi | PHP/Laravel Engineer. I build systems that survive production." />
    
    <meta property="og:title" content="Why Hire Fazley? | PHP/Laravel Engineer" />
    <meta property="og:description" content="I build systems that survive production. Interactive portfolio demonstrating real-world engineering experience." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://whyhire.fazleyrabbi.xyz" />
    <meta property="og:image" content="https://whyhire.fazleyrabbi.xyz/images/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Why Hire Fazley?" />
    <meta name="twitter:description" content="I build systems that survive production." />
    <meta name="twitter:image" content="https://whyhire.fazleyrabbi.xyz/images/og.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Outfit:wght@400;700;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Engineering Core 3D Container -->
    <div id="webgl-container"></div>
    <AISummarizer client:load />
    
    <main>
      <slot />
    </main>
  </body>
</html>
