---
// src/components/Contact.astro
---

<section id="contact" class="section">
  <div class="container">
    <div class="contact-card glass-panel">
      <div class="contact-header">
        <span class="mono text-accent">[06 // GET IN TOUCH]</span>
        <h2 class="contact-title">HAVE A HARD PROBLEM? <br /><span class="text-accent">I LIKE THOSE.</span></h2>
        <p class="contact-subtitle">
          Whether you need a senior engineer for a high-volume Laravel project, a payment/webhook integration, or database optimization, let's connect.
        </p>
      </div>

      <div class="services-row">
        <div class="service-pill mono">
          <span class="text-accent">✓</span> Multi-Gateway Payments & Webhooks
        </div>
        <div class="service-pill mono">
          <span class="text-accent">✓</span> MySQL & ClickHouse Optimization
        </div>
        <div class="service-pill mono">
          <span class="text-accent">✓</span> Full-Stack Laravel System Architecture
        </div>
      </div>

      <div class="contact-action-box">
        <div class="email-display">
          <span class="mono text-muted">DIRECT EMAIL:</span>
          <span class="email-address mono" id="email-text">fazley111@gmail.com</span>
        </div>

        <div class="action-buttons">
          <a href="mailto:fazley111@gmail.com" class="btn btn-primary">Send Email ↗</a>
          <button class="btn btn-outline" id="copy-email-btn">Copy Address</button>
          <a href="https://github.com/fazleyrabby" target="_blank" rel="noopener noreferrer" class="btn btn-outline">GitHub ↗</a>
          <a href="https://linkedin.com/in/fazley-rabby" target="_blank" rel="noopener noreferrer" class="btn btn-outline">LinkedIn ↗</a>
          <a href="https://fazleyrabbi.xyz/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Standard Portfolio ↗</a>
        </div>
      </div>

      <div class="contact-footer mono text-muted">
        <span>● BASED IN BANGLADESH (AVAILABLE FOR GLOBAL TEAMS)</span>
        <span class="text-accent">[TYPICAL RESPONSE: &lt; 12 HOURS]</span>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = 'fazley111@gmail.com';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      const originalText = copyBtn.innerText;
      copyBtn.innerText = 'Copied to Clipboard!';
      copyBtn.classList.add('text-accent');
      setTimeout(() => {
        copyBtn.innerText = originalText;
        copyBtn.classList.remove('text-accent');
      }, 2000);
    } catch (err) {
      console.error('Failed to copy', err);
    }
  });
</script>

<style>
  .contact-card {
    padding: 3.5rem;
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .contact-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin: 0.5rem 0 1rem 0;
    line-height: 1.1;
  }

  .contact-subtitle {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    max-width: 750px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .services-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .service-pill {
    padding: 0.5rem 1rem;
    background: var(--glass-light-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .contact-action-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--glass-dark-bg);
    border-radius: 12px;
    border: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .contact-action-box {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .email-display {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .email-address {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: 1.75rem;
    }
  }
</style>
