---
// src/components/Homelab.astro
import { homelabData } from '../data/homelab';
import HomelabDiagram from './HomelabDiagram';

const infrastructureHighlights = [
  {
    role: "WEB & APPLICATION SERVER",
    tech: "FrankenPHP & Laravel (Worker Mode)",
    instances: "High-Throughput Caddy",
    memory: "PHP 8.3",
    benefit: "Keeps Laravel boot in memory with worker mode, slashing response latency down to sub-10ms for production apps."
  },
  {
    role: "EDGE INGRESS & ZERO OPEN PORTS",
    tech: "Cloudflare Tunnels (cloudflared)",
    instances: "Zero Attack Surface",
    memory: "Auto TLS",
    benefit: "Outbound-only encrypted tunnels route global traffic directly to Docker without port forwarding or exposed server IPs."
  },
  {
    role: "PRIVATE SECURE REMOTE ACCESS",
    tech: "Tailscale Mesh VPN (WireGuard)",
    instances: "Encrypted Overlay",
    memory: "NAT Traversal",
    benefit: "Enables direct, secure SSH and management access from any device across firewalls and CGNAT with zero public exposure."
  },
  {
    role: "AUTONOMOUS INFRASTRUCTURE AI",
    tech: "Hermes Sysadmin Agent (Telegram)",
    instances: "Shell & Container Ops",
    memory: "Zero API Fees",
    benefit: "Custom AI agent orchestrating shell commands, diagnosing 502/1033 errors, and managing cron jobs directly from my phone."
  },
  {
    role: "HIGH-PERFORMANCE DATA STACK",
    tech: "MySQL 8.0 & Redis 7 Caching",
    instances: "5 DB Instances Consolidated",
    memory: "386 MB",
    benefit: "Tuned InnoDB buffer pools and sub-millisecond in-memory caching for extreme multi-tenant app load resilience."
  }
];
---

<section id="homelab" class="section">
  <div class="container">
    <div class="section-badge mono text-accent">[04 // FULL-STACK OWNERSHIP]</div>
    <h2 class="section-title">SERVER ARCHITECTURE & DEVOPS</h2>
    <p class="section-subtitle">
      I don't just write application code—I run a production bare-metal server powering real applications, zero-trust networks, and autonomous AI infrastructure.
    </p>

    <div class="homelab-dashboard glass-panel">
      {/* Visual Infrastructure Topology Diagram */}
      <div class="topology-banner">
        <HomelabDiagram client:visible />
      </div>

      {/* High-Level Executive Telemetry */}
      <div class="telemetry-grid">
        <div class="telemetry-box">
          <div class="telemetry-num text-accent mono">{homelabData.totalContainers} ACTIVE</div>
          <div class="telemetry-desc mono">PRODUCTION DOCKER CONTAINERS</div>
        </div>
        <div class="telemetry-box">
          <div class="telemetry-num text-accent mono">99.98%</div>
          <div class="telemetry-desc mono">SYSTEM UPTIME (BARE-METAL HOST)</div>
        </div>
        <div class="telemetry-box">
          <div class="telemetry-num text-accent mono">ZERO PORTS</div>
          <div class="telemetry-desc mono">PUBLICLY EXPOSED (ZERO-TRUST MESH)</div>
        </div>
      </div>

      {/* Clear, Plain-English Infrastructure Capabilities */}
      <div class="server-rack">
        {infrastructureHighlights.map((item) => (
          <div class="server-blade">
            <div class="blade-header">
              <div class="blade-titles">
                <span class="blade-role mono text-accent">{item.role}</span>
                <h3 class="blade-tech">{item.tech}</h3>
              </div>
              <div class="blade-meta mono">
                <span class="badge-instances">{item.instances}</span>
                <span class="badge-memory text-accent">{item.memory}</span>
              </div>
            </div>
            <p class="blade-benefit">{item.benefit}</p>
          </div>
        ))}
      </div>

      {/* Deep-Dive Article CTA */}
      <div class="article-cta glass-panel">
        <div class="cta-content">
          <span class="cta-tag mono text-accent">DEEP-DIVE ARTICLE</span>
          <h4 class="cta-title">Running a Production-Grade Homelab on Bare Metal</h4>
          <p class="cta-desc">Read the full breakdown on routing, Cloudflare tunnels, error recovery (502 & 1033), and zero-cost AI agents.</p>
        </div>
        <a 
          href="https://fazleyrabbi.xyz/posts/running-a-production-grade-homelab-on-bare-metal" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="cta-button mono"
        >
          READ ARCHITECTURE POST →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-badge {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .section-title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  
  .section-subtitle {
    max-width: 780px;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .homelab-dashboard {
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .topology-banner {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .telemetry-box {
    padding: 1.25rem 1.5rem;
    background: rgba(17, 24, 39, 0.7);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .telemetry-num {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .telemetry-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .server-rack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .server-blade {
    padding: 1.5rem 1.75rem;
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: all 0.25s ease;
  }

  .server-blade:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .blade-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .blade-role {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .blade-tech {
    font-size: 1.35rem;
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .blade-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .badge-instances {
    padding: 0.25rem 0.65rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .badge-memory {
    padding: 0.25rem 0.65rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .blade-benefit {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .article-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.05);
    border-radius: 8px;
  }

  .cta-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .cta-title {
    font-size: 1.2rem;
    margin: 0 0 0.25rem 0;
    color: var(--color-text);
  }

  .cta-desc {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .cta-button {
    padding: 0.85rem 1.5rem;
    background: var(--color-accent);
    color: #030712;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .cta-button:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .homelab-dashboard {
      padding: 1.25rem;
    }
    .blade-header {
      flex-direction: column;
      gap: 0.75rem;
    }
    .blade-meta {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .article-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem;
    }
    .cta-button {
      width: 100%;
      text-align: center;
    }
  }
</style>
