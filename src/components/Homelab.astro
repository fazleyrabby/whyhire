---
// src/components/Homelab.astro
import { homelabData } from '../data/homelab';

const infrastructureHighlights = [
  {
    role: "HIGH-PERFORMANCE DATABASES",
    tech: "MySQL 8.0 & Redis 7",
    instances: "5 DB Instances Consolidated",
    memory: "386 MB",
    benefit: "Tuned InnoDB buffer pools, query indexes, and sub-millisecond in-memory caching for extreme load resilience."
  },
  {
    role: "AUTOMATED CI/CD BUILD ENGINE",
    tech: "Ephemeral Docker Runners",
    instances: "On-Demand Workers",
    memory: "35 MB",
    benefit: "Spawns ephemeral isolated containers via GitHub webhooks to test and deploy code in seconds without cloud CI bills."
  },
  {
    role: "ZERO-TRUST SECURITY & REVERSE PROXY",
    tech: "Traefik v3 & Tailscale Mesh",
    instances: "Encrypted WireGuard",
    memory: "Auto SSL",
    benefit: "Zero exposed public ports. All microservices communicate across private encrypted channels with automated certificates."
  },
  {
    role: "REAL-TIME OBSERVABILITY & METRICS",
    tech: "Grafana 11.5 & Prometheus",
    instances: "Full Telemetry Stack",
    memory: "250 MB",
    benefit: "Continuous tracking of container health, latency, and memory spikes to diagnose bottlenecks before users notice."
  },
  {
    role: "ASYNC QUEUES & SELF-HOSTED AI",
    tech: "Oblok Engine & Local LLMs",
    instances: "5 Worker Nodes",
    memory: "427 MB",
    benefit: "Handles heavy background tasks, scheduled jobs, and private AI completions without vendor lock-in or rate limits."
  }
];
---

<section id="homelab" class="section">
  <div class="container">
    <div class="section-badge mono text-accent">[04 // FULL-STACK OWNERSHIP]</div>
    <h2 class="section-title">SERVER ARCHITECTURE & DEVOPS</h2>
    <p class="section-subtitle">
      I don't just write application code—I configure and manage the Linux servers, databases, and networks that keep systems fast, secure, and resilient.
    </p>

    <div class="homelab-dashboard glass-panel">
      {/* High-Level Executive Telemetry */}
      <div class="telemetry-grid">
        <div class="telemetry-box">
          <div class="telemetry-num text-accent mono">{homelabData.totalContainers} ACTIVE</div>
          <div class="telemetry-desc mono">PRODUCTION DOCKER CONTAINERS</div>
        </div>
        <div class="telemetry-box">
          <div class="telemetry-num text-accent mono">99.98%</div>
          <div class="telemetry-desc mono">SYSTEM UPTIME (UBUNTU HOST)</div>
        </div>
        <div class="telemetry-box">
          <div class="telemetry-num text-accent mono">ZERO PORTS</div>
          <div class="telemetry-desc mono">PUBLICLY EXPOSED (ENCRYPTED MESH)</div>
        </div>
      </div>

      {/* Clear, Plain-English Infrastructure Capabilities */}
      <div class="server-rack">
        {infrastructureHighlights.map((item, index) => (
          <div class="server-blade" style={`--delay: ${index * 0.08}s`}>
            <div class="blade-header">
              <div class="blade-titles">
                <span class="blade-role mono text-accent">{item.role}</span>
                <h3 class="blade-tech">{item.tech}</h3>
              </div>
              <div class="blade-meta mono">
                <span class="badge-instances">{item.instances}</span>
                <span class="badge-memory text-accent">{item.memory}</span>
              </div>
            </div>
            <p class="blade-benefit">{item.benefit}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section-badge {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .section-title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  
  .section-subtitle {
    max-width: 750px;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .homelab-dashboard {
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .telemetry-box {
    padding: 1.25rem;
    background: var(--glass-dark-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .telemetry-num {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .telemetry-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .server-rack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .server-blade {
    padding: 1.5rem 1.75rem;
    background: var(--glass-dark-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: all 0.25s ease;
  }

  .server-blade:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .blade-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .blade-role {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .blade-tech {
    font-size: 1.25rem;
    margin: 0;
    color: var(--color-text);
  }

  .blade-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .blade-benefit {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .homelab-dashboard {
      padding: 1.25rem;
    }
    .blade-header {
      flex-direction: column;
      gap: 0.5rem;
    }
    .blade-meta {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>
